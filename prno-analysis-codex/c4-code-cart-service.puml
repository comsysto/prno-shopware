@startuml C4_Code_CartService
'-----------------------------------------------------------------------------'
' C4-PlantUML code-level (class) diagram for Cart Service
'-------------------------------------------------------------------------------'
!define RELATIVE_INCLUDE
!include ./C4P/C4_Container.puml
!include ./C4P/C4_Component.puml

'-----------------------------------------------------------------------------'
' Code-level diagram inside Cart Service container
'-------------------------------------------------------------------------------'
Container_Boundary(cartService, "Cart Service", "PHP, Symfony") {
  class CartService {
    .. Business logic for cart operations, orchestrating cart persistence, calculation, and routes ..
  }

  class CartFactory {
    .. Creates and initializes Cart instances ..
  }
  class CartCalculator {
    .. Calculates pricing, taxes, totals and promotions ..
  }
  class AbstractCartPersister {
    .. Persists and retrieves cart data to storage ..
  }
  class AbstractCartLoadRoute {
    .. Loads a cart by token through REST route ..
  }
  class AbstractCartDeleteRoute {
    .. Deletes a cart through REST route ..
  }
  class AbstractCartItemAddRoute {
    .. Adds line items to a cart via REST route ..
  }
  class AbstractCartItemUpdateRoute {
    .. Updates line items in a cart via REST route ..
  }
  class AbstractCartItemRemoveRoute {
    .. Removes line items from a cart via REST route ..
  }
  class AbstractCartOrderRoute {
    .. Processes order placement from a cart via REST route ..
  }
  class CartResponse {
    .. Response returned after loading a cart ..
  }
  class CartOrderRouteResponse {
    .. Response returned after placing an order ..
  }
  class Cart {
    .. A customer's shopping cart, containing line items ..
  }
  class LineItem {
    .. Represents a line item in the cart ..
  }
  class SalesChannelContext {
    .. Context of the sales channel for request execution ..
  }
  class RequestDataBag {
    .. Wrapper for request data parameters ..
  }
  class EventDispatcherInterface {
    .. Publishes and dispatches events within the system ..
  }

  class LineItemFactoryRegistry {
    .. Registers and delegates to type-specific line item factories ..
  }
  class LineItemFactoryInterface {
    .. Defines methods to create and update LineItem instances from data ..
  }
  class CreditLineItemFactory {
    .. Builds credit line items from input data ..
  }
  class CustomLineItemFactory {
    .. Builds custom line items from input data ..
  }
  class ProductLineItemFactory {
    .. Builds product line items, applying price definitions ..
  }
  class PromotionLineItemFactory {
    .. Builds promotion line items with discount definitions ..
  }
  class DataValidator {
    .. Validates raw input data against defined validation rules ..
  }

  CartService --> AbstractCartPersister : "saves and loads cart data\nPHP method call"
  CartService --> EventDispatcherInterface : "dispatches cart events\nPHP method call"
  CartService --> CartCalculator : "recalculates cart totals\nPHP method call"
  CartService --> AbstractCartLoadRoute : "loads cart via REST route\nPHP method call"
  CartService --> AbstractCartDeleteRoute : "deletes cart via REST route\nPHP method call"
  CartService --> AbstractCartItemAddRoute : "adds items via REST route\nPHP method call"
  CartService --> AbstractCartItemUpdateRoute : "updates items via REST route\nPHP method call"
  CartService --> AbstractCartItemRemoveRoute : "removes items via REST route\nPHP method call"
  CartService --> AbstractCartOrderRoute : "places order via REST route\nPHP method call"
  CartService --> CartFactory : "creates new carts\nPHP method call"
  CartFactory --> LineItemFactoryRegistry : "creates or updates line items\nPHP method call"
  LineItemFactoryRegistry --> DataValidator : "validates input data\nPHP method call"
  LineItemFactoryRegistry --> EventDispatcherInterface : "dispatches validation events\nPHP method call"
  LineItemFactoryRegistry --> LineItemFactoryInterface : "delegates by type\nPHP method call"
  LineItemFactoryRegistry --> Cart : "updates existing line items"
  LineItemFactoryRegistry --> SalesChannelContext : "requires sales channel context"
  LineItemFactoryRegistry --> LineItem : "returns built line items"
  LineItemFactoryRegistry --> CreditLineItemFactory : "supports credit type"
  LineItemFactoryRegistry --> CustomLineItemFactory : "supports custom type"
  LineItemFactoryRegistry --> ProductLineItemFactory : "supports product type"
  LineItemFactoryRegistry --> PromotionLineItemFactory : "supports promotion type"
  CartService --> Cart : "manages Cart instances"
  CartService --> SalesChannelContext : "requires sales channel context"
  CartService --> RequestDataBag : "accepts request data parameters"
  CartService --> LineItem : "manipulates line items in cart"

}

LAYOUT_LEFT_RIGHT()
SHOW_LEGEND()

@enduml
